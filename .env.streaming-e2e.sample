# Streaming-clients full-flow e2e — copy to .env.streaming-e2e and fill in.
# .env.streaming-e2e is gitignored.

# nzbdav-rs build — raw Forgejo cargo token hash (Dockerfile prepends "token ")
CARGO_REGISTRIES_FORGEJO_TOKEN=replace-with-forgejo-cargo-token

# nzbdav-rs runtime
NZBDAV_API_KEY=testkey
NZBDAV_WEBDAV_USER=user
NZBDAV_WEBDAV_PASS=pass

# Usenet provider (used to auto-configure nzbdav after boot)
USENET_HOST=news.example.com
USENET_PORT=563
USENET_SSL=true
USENET_USER=changeme
USENET_PASS=changeme
USENET_CONNECTIONS=20

# Newznab indexer (used to auto-configure NZBHydra2)
INDEXER_NAME=my-indexer
INDEXER_URL=https://api.example.org
INDEXER_API_KEY=changeme

# Test parameters
# Number of recent NZBs to pull during the search step
SEARCH_LIMIT=5
# Hard ceiling on download wait (seconds). Patient = 900s = 15min.
DOWNLOAD_TIMEOUT=900
# Streaming-client shared secret (UsenetStreamer addon token)
STREAMER_SHARED_SECRET=testtoken
